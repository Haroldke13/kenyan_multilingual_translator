LANGUAGE_ASR_BACKEND=transformers
LANGUAGE_ASR_MODEL=Kiragu/whisper-small-language-v5
LANGUAGE_TRANSLATION_MODEL=nickdee96/nllb-200-600m-language-english
LANGUAGE_TRANSLATION_SRC_LANG=kik_Latn
LANGUAGE_TRANSLATION_TGT_LANG=eng_Latn
LANGUAGE_MAX_UPLOAD_MB=512
# Set this on a phone/client to use a faster remote FastAPI server instead of local inference.
# LANGUAGE_API_URL=https://your-server.example
LANGUAGE_API_TIMEOUT=900
# Set these on the server if it should listen on the network.
LANGUAGE_API_HOST=127.0.0.1
LANGUAGE_API_PORT=8000

LANGUAGE_ASR_CHUNK_SECONDS=12
LANGUAGE_ASR_RETRY_CHUNK_SECONDS=6
LANGUAGE_ASR_SILENCE_RMS=0.001
LANGUAGE_ASR_MAX_NEW_TOKENS=96
LANGUAGE_ASR_NO_REPEAT_NGRAM_SIZE=3
LANGUAGE_ASR_REPETITION_PENALTY=1.15
LANGUAGE_TRANSLATION_MAX_NEW_TOKENS=128
LANGUAGE_TORCH_THREADS=1
LANGUAGE_KEEP_ASR_LOADED=0
LANGUAGE_KEEP_TRANSLATION_LOADED=0
